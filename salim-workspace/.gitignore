# Keep Salim out of the host project's automatic content scans.
# Reviewed source is explicitly tracked; dependency/build output must never be added.
*

# Explicitly tracked native advertising integration; every other new capsule file stays ignored.
!apps/
!apps/salim-android/
!apps/salim-android/app/
!apps/salim-android/app/src/
!apps/salim-android/app/src/main/
!apps/salim-android/app/src/main/java/
!apps/salim-android/app/src/main/java/app/
!apps/salim-android/app/src/main/java/app/salim/
!apps/salim-android/app/src/main/java/app/salim/AdMob.kt
!apps/salim-ios/
!apps/salim-ios/Salim/
!apps/salim-ios/Salim/Ads.swift

# Founder-approved Salim venture document library; keep generated/runtime material ignored.
!docs/
!docs/README.md
!docs/*.md
!docs/business/
!docs/business/*.md
!docs/research/
!docs/research/*.md
!docs/PROJECT-HANDOVER-LOG.md
