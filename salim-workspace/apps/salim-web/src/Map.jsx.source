export function AlertIcon({ kind, size = 18 }) {
  const Icon =
    kind === "camera"
      ? Camera
      : kind === "roadwork"
        ? Construction
        : TriangleAlert;
  return <Icon size={size} />;
}
export default function RoadMap({
  zoom,
  cameras,
  traffic,
  selected,
  onSelect,
  progress,
}) {
  return (
