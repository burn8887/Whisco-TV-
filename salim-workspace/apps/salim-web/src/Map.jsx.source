              className={`map-marker ${a.kind} ${selected === a.id ? "selected" : ""}`}
              style={{ left: `${a.x}%`, top: `${a.y}%` }}
              onClick={() => onSelect(a.id)}
              aria-label={`${a.title}, ${a.road}`}
            >
              <AlertIcon kind={a.kind} size={16} />
            </button>
