// Whisco TV — Free Ad-Supported TV (FAST) Platform Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// USERS & AUTH
// ------------------------------
// Whisco TV is 100% free and ad-supported — no subscriptions or billing.
// Accounts are optional and only used for personalization: profiles,
// watchlists, and resume-watching progress.

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("VIEWER")
  createdAt     DateTime  @default(now())
  avatarColor   String    @default("#f97316")

  profiles      Profile[]
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  isKids    Boolean  @default(false)
  avatar    String   @default("👤")
  pin       String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist[]
  progress  WatchProgress[]
  createdAt DateTime @default(now())
}

// ------------------------------
// LIVE TV (FAST channels)
// ------------------------------

model Channel {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String
  streamUrl    String   // Free-to-air / ad-supported public HLS stream
  country      String
  countryCode  String
  language     String   @default("English")
  category     String   // News, Sports, Entertainment, Kids, Movies, Documentary, Music, Lifestyle
  isHD         Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)   // false = hidden from viewers (failed health checks)
  failCount    Int      @default(0)      // consecutive failed daily health checks
  lastCheckedAt DateTime?
  lastStatus   String?                   // "ok" | "unreachable" | "invalid" — from the last health check
  number       Int      @default(0)
  epg          EpgEntry[]
  // ---- PROVENANCE + STORE CLEARANCE (Apple 5.2.2, build 6) ----------------
  // FAIL CLOSED: clearedForApp defaults false, so every harvested row is
  // invisible to the iOS store build until a human ticks it with evidence.
  sourceKind       String?   // "iptv-org" | "youtube-live" (App-Store-only) | "manual"
  provenanceUrl    String?   // where we got it (e.g. the iptv-org issue URL)
  officialSiteUrl  String?   // the broadcaster's own page for this channel
  rightsBasis      String?   // plain-English reason we believe we may carry it
  evidenceUrl      String?   // link a reviewer can open and check
  clearedForApp    Boolean   @default(false)
  clearedAt        DateTime?
  clearedBy        String?
}

model EpgEntry {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title     String
  description String
  startTime DateTime
  endTime   DateTime
}

// ------------------------------
// VOD (Video on Demand) — free, ad-supported
// ------------------------------

model Title {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  type         String
  synopsis     String
  posterUrl    String
  backdropUrl  String
  releaseYear  Int
  rating       String   @default("PG-13")
  imdbRating   Float    @default(7.0)
  durationMins Int?     // for movies
  genres       String   // comma separated
  collection   String   @default("")  // curated viewer-facing shelf, e.g. "Cartoons & Animation"
  cast         String   // comma separated
  director     String   @default("")
  country      String   @default("USA")
  language     String   @default("English")
  isFeatured   Boolean  @default(false)
  isNew        Boolean  @default(false)
  isTrending   Boolean  @default(false)
  streamUrl    String?  // for movies
  isActive     Boolean  @default(true)   // false = hidden from viewers (failed VOD health checks)
  failCount    Int      @default(0)      // consecutive failed health checks
  lastCheckedAt DateTime?
  lastStatus   String?                   // "ok" | "invalid" | "unknown" — from the last VOD health check
  createdAt    DateTime @default(now())

  seasons      Season[]
  watchlistedBy Watchlist[]
  progress     WatchProgress[]
  // ---- PROVENANCE + STORE CLEARANCE (Apple 5.2.2, build 6) ----------------
  // sourceKind: "youtube-official-channel" | "archive-org" | "none"
  // uploaderChannelId is the OFFICIAL rights-holder channel the item came from.
  // FAIL CLOSED: clearedForApp defaults false.
  sourceKind        String?
  uploaderChannelId String?
  uploaderUrl       String?
  rightsBasis       String?
  evidenceUrl       String?
  clearedForApp     Boolean   @default(false)
  clearedAt         DateTime?
  clearedBy         String?
  articles     Article[]
}

model Season {
  id        String   @id @default(cuid())
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  number    Int
  episodes  Episode[]
}

model Episode {
  id           String   @id @default(cuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number       Int
  name         String
  synopsis     String
  durationMins Int      @default(45)
  stillUrl     String
  streamUrl    String
  progress     WatchProgress[]
}

model Watchlist {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([profileId, titleId])
}

model WatchProgress {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  titleId    String
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodeId  String?
  episode    Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSecs Int    @default(0)
  totalSecs    Int    @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([profileId, titleId, episodeId])
}

// In-house editorial. One Article row per piece of original writing: series
// guides, character studies, season arcs, and single-episode essays. This is the
// product differentiator the founder mandated ("an article for every episode")
// and simultaneously the answer to AdSense's "low value content" finding —
// original writing on a catalogue page is what turns it from thin to valuable.
// ---------------------------------------------------------------------------
model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  titleId         String
  kind            String    @default("SERIES_GUIDE") // SERIES_GUIDE | CHARACTER | SEASON | EPISODE | ESSAY
  headline        String
  dek             String
  body            String
  author          String    @default("Whisco Editorial")
  readingTimeMins Int       @default(5)
  tags            String[]
  episodeNumber   Int?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([titleId])
  @@index([published, publishedAt])
}
