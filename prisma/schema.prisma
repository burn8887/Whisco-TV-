// Whisco TV — Free Ad-Supported TV (FAST) Platform Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// USERS & AUTH
// ------------------------------
// Whisco TV is 100% free and ad-supported — no subscriptions or billing.
// Accounts are optional and only used for personalization: profiles,
// watchlists, and resume-watching progress.

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("VIEWER")
  createdAt     DateTime  @default(now())
  avatarColor   String    @default("#f97316")

  profiles      Profile[]
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  isKids    Boolean  @default(false)
  avatar    String   @default("👤")
  pin       String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist Watchlist[]
  progress  WatchProgress[]
  createdAt DateTime @default(now())
}

// ------------------------------
// LIVE TV (FAST channels)
// ------------------------------

model Channel {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String
  streamUrl    String   // Free-to-air / ad-supported public HLS stream
  country      String
  countryCode  String
  language     String   @default("English")
  category     String   // News, Sports, Entertainment, Kids, Movies, Documentary, Music, Lifestyle
  isHD         Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  number       Int      @default(0)
  epg          EpgEntry[]
}

model EpgEntry {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title     String
  description String
  startTime DateTime
  endTime   DateTime
}

// ------------------------------
// VOD (Video on Demand) — free, ad-supported
// ------------------------------

model Title {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  type         String
  synopsis     String
  posterUrl    String
  backdropUrl  String
  releaseYear  Int
  rating       String   @default("PG-13")
  imdbRating   Float    @default(7.0)
  durationMins Int?     // for movies
  genres       String   // comma separated
  cast         String   // comma separated
  director     String   @default("")
  country      String   @default("USA")
  language     String   @default("English")
  isFeatured   Boolean  @default(false)
  isNew        Boolean  @default(false)
  isTrending   Boolean  @default(false)
  streamUrl    String?  // for movies
  createdAt    DateTime @default(now())

  seasons      Season[]
  watchlistedBy Watchlist[]
  progress     WatchProgress[]
}

model Season {
  id        String   @id @default(cuid())
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  number    Int
  episodes  Episode[]
}

model Episode {
  id           String   @id @default(cuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number       Int
  name         String
  synopsis     String
  durationMins Int      @default(45)
  stillUrl     String
  streamUrl    String
  progress     WatchProgress[]
}

model Watchlist {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  titleId   String
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([profileId, titleId])
}

model WatchProgress {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  titleId    String
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodeId  String?
  episode    Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSecs Int    @default(0)
  totalSecs    Int    @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([profileId, titleId, episodeId])
}
