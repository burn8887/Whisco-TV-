# Copy this file to .env and fill in your own values.

# Free Postgres works great here — e.g. Neon (https://neon.tech) or
# Vercel Postgres. Example format:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate a strong random secret for production, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-long-random-string"

# Protects the daily channel health-check cron endpoint from being triggered
# by anyone else. Generate with: openssl rand -hex 24
# Must match the CRON_SECRET env var set in your Vercel project settings.
CRON_SECRET="replace-this-with-a-long-random-string"
